<?xml version="1.0" encoding="utf-8"?>
<!-- Backup rules for Android 12 and higher. Session tokens are never backed up or transferred. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="nova_backend_runtime.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="nova_backend_runtime.xml" />
    </device-transfer>
</data-extraction-rules>
